# Slipstream F1 — backend environment variables
# Copy to server/.env and fill in. All have safe local-dev defaults except
# secrets you provide for production.

# Server
PORT=3001
# Base URL for magic links (<FRONTEND_URL>/auth/verify?token=...). On Vercel,
# set this for Production (e.g. https://slipstreamf1.vercel.app); leave it
# unset for Preview so links point at each preview's own URL.
FRONTEND_URL=http://localhost:5173

# Sign-up. Closed by default: only emails already in the users table can sign
# in. Open it for local dev; leave it unset in production to keep it private.
REGISTRATION_OPEN=true

# Auth / JWT — generate a strong random value for production
SECRET_KEY=dev-secret-change-me
JWT_EXPIRY_DAYS=7

# Database — Turso (libSQL). Leave both unset to use a local ./dev.db file.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token_here

# Email — Resend magic links. Leave unset to log magic links to the console.
# RESEND_API_KEY=re_your_key_here
# Sender address. Resend's shared test sender only delivers to your own Resend
# account email; use an address on a domain verified in Resend for real users.
# EMAIL_FROM=Slipstream <onboarding@resend.dev>

# Frontend (client/.env) — points the React app at the API
VITE_API_URL=http://localhost:3001/api
